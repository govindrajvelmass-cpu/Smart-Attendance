# ==========================================================
# SMART ATTENDANCE MANAGEMENT SYSTEM - BACKEND ENVIRONMENT CONFIG
# ==========================================================
# Copy this file to backend/.env and fill in your credentials.
#
# IMPORTANT FOR GMAIL USERS:
# 1. You must have 2-Step Verification turned ON in your Google Account.
# 2. Go to: https://myaccount.google.com/apppasswords
# 3. Create an App Name (e.g. "Smart Attendance") and click Create.
# 4. Copy the generated 16-character password (e.g. abcd efgh ijkl mnop).
# 5. Paste it below into MAIL_PASSWORD (spaces will be automatically trimmed).
# 6. Set MAIL_USERNAME and MAIL_FROM to your full Gmail address.
#
# SMTP Configuration:
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=your-email@gmail.com
MAIL_PASSWORD=your-16-char-app-password
MAIL_FROM=your-email@gmail.com

# Frontend Application URL (used in email links sent to students):
FRONTEND_URL=http://localhost:5173
